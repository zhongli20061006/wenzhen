# ============================================================
# 智能预问诊系统 — Docker 部署环境变量模板
# 复制此文件为 .env 并填写实际值:
#   cp .env.docker .env
#   编辑 .env 后运行: docker-compose up -d
# ============================================================

# ---------- 数据库 ----------
DB_PASSWORD=your-strong-db-password-here
DB_NAME=pre_consultation
DB_EXTERNAL_PORT=3307

# ---------- JWT 认证 ----------
# 生成随机密钥: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- 端口映射 ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- CORS ----------
# 开发环境可用 *，生产环境必须限定域名
# 示例: CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=*

# ---------- DeepSeek AI ----------
# 不设置 API Key 时系统降级为纯规则引擎（仍可正常工作）
DEEPSEEK_API_KEY=

# ---------- 问诊参数 ----------
AI_MODE=degrade
MAX_QUESTION_ROUNDS=5
CANDIDATE_THRESHOLD=3
DISCRIMINATION_THRESHOLD=0.15
