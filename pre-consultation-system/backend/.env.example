# ============================================================
# 智能预问诊系统 — 环境变量配置模板
# 复制此文件为 .env 并填写实际值:
#   cp .env.example .env
# ============================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
# ⚠ 生产环境必须修改为强密码
DB_PASSWORD=your-db-password-here
DB_NAME=pre_consultation

# ---------- JWT 认证 ----------
# ⚠ 生产环境必须替换为随机密钥（生成方式见下方）
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- CORS ----------
# 开发环境可用 *，生产环境必须限定域名（逗号分隔多个）
# 示例: CORS_ORIGINS=https://example.com,https://admin.example.com
CORS_ORIGINS=*

# ---------- DeepSeek AI ----------
# 不设置 API Key 时系统降级为纯规则引擎（仍可正常工作）
DEEPSEEK_API_KEY=
# AI 模式: degrade(有Key则用，无则降级) | rule_only(只用规则)
AI_MODE=degrade
DEEPSEEK_ENABLED=true

# ---------- 问诊参数 ----------
MAX_QUESTION_ROUNDS=5
CANDIDATE_THRESHOLD=3
DISCRIMINATION_THRESHOLD=0.15
